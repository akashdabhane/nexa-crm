# PostgreSQL (docker compose exposes it on 5433 to avoid clashing with a local install)
DATABASE_URL=postgresql+psycopg://nexa:nexa@localhost:5433/nexa_crm

# Supabase project URL (Project Settings -> API). Used to fetch the JWKS public keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# Only needed if your project still signs tokens with the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# AI assistant: which chat model answers. "gemini" (Google's API) or "ollama" (a local model).
LLM_PROVIDER=gemini

# Gemini (used when LLM_PROVIDER=gemini). Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried when the main model is overloaded or out of quota. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Ollama (used when LLM_PROVIDER=ollama). Install Ollama, then: ollama pull qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

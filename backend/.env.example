# PostgreSQL (docker compose exposes it on 5433 to avoid clashing with a local install)
DATABASE_URL=postgresql+psycopg://nexa:nexa@localhost:5433/nexa_crm

# Supabase project URL (Project Settings -> API). Used to fetch the JWKS public keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# Only needed if your project still signs tokens with the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

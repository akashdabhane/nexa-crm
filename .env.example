# Variables for `docker compose` (copy to .env in the project root). The local, non-Docker setup uses
# backend/.env and frontend/.env.local instead.

# Supabase project (Project Settings -> API). The publishable/anon key is safe to expose.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Only needed if your project still signs tokens with the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# AI assistant: which chat model answers. "gemini" (Google's API) or "ollama" (a local model).
LLM_PROVIDER=gemini

# Gemini (used when LLM_PROVIDER=gemini). Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried when the main model is overloaded or out of quota. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Ollama (used when LLM_PROVIDER=ollama), running on the host: ollama pull qwen3:4b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
